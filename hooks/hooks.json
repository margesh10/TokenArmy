{
  "description": "TokenArmy: compress tool output, dedupe re-reads, checkpoint across compaction",
  "hooks": {
    "PostToolUse": [
      { "matcher": "Bash|PowerShell|Read|Grep", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/claude-posttooluse.js\"", "timeout": 10 }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/claude-lifecycle.js\"", "timeout": 10 }] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/claude-lifecycle.js\"", "timeout": 10 }] }
    ]
  }
}
